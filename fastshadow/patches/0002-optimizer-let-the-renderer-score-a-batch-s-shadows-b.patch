From d860cd6085ac4412c3935c1a8b39cd11abd74178 Mon Sep 17 00:00:00 2001
From: Tony Hwang <godntony@gmail.com>
Date: Wed, 14 Oct 2026 15:06:07 -0400
Subject: [PATCH 2/2] optimizer: let the renderer score a batch's shadows
 (batch_shadow_loss hook)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 motion-aware-shadow/optimizer.py | 27 ++++++++++++++++++++-------
 1 file changed, 20 insertions(+), 7 deletions(-)

diff --git a/motion-aware-shadow/optimizer.py b/motion-aware-shadow/optimizer.py
index 4ea1487..afed259 100644
--- a/motion-aware-shadow/optimizer.py
+++ b/motion-aware-shadow/optimizer.py
@@ -801,10 +801,13 @@ def _full_loss(
 
 
 def _full_loss_from(
-    mask, min_z, cross_pen, self_pen, q_full, target, config, q_ref_frozen, active
+    mask, min_z, cross_pen, self_pen, q_full, target, config, q_ref_frozen, active,
+    shadow=None,
 ) -> float:
-    loss = shadow_loss(
-        mask, target, config.alpha, config.beta, config.gamma, config.delta
+    loss = (
+        shadow_loss(mask, target, config.alpha, config.beta, config.gamma, config.delta)
+        if shadow is None
+        else shadow
     )
     loss += floor_penalty_loss(
         min_z,
@@ -850,9 +853,11 @@ def _compute_fd_grad(
             Q[2 * j, active[j]] += epsilon
             Q[2 * j + 1, active[j]] -= epsilon
         masks, min_zs, crosses, selfs = renderer.eval_q_batch(Q)
+        sl = getattr(renderer, "batch_shadow_loss", lambda _t: None)(target)
         losses = [
             _full_loss_from(masks[i], min_zs[i], crosses[i], selfs[i], Q[i],
-                            target, config, q_ref_frozen, active)
+                            target, config, q_ref_frozen, active,
+                            None if sl is None else float(sl[i]))
             for i in range(2 * n)
         ]
         grad = np.array(
@@ -1222,13 +1227,21 @@ def optimize(
         Q_full = np.tile(x0_full, (len(X_active), 1))
         Q_full[:, active] = X_active
         masks, min_zs, crosses, selfs = renderer.eval_q_batch(Q_full)
+        # A renderer may score the shadows itself (one GPU call for the batch);
+        # None means use shadow_loss below.
+        sl = getattr(renderer, "batch_shadow_loss", lambda _t: None)(target)
         return [
-            _score(masks[i], min_zs[i], crosses[i], selfs[i], X_active[i])
+            _score(masks[i], min_zs[i], crosses[i], selfs[i], X_active[i],
+                   None if sl is None else float(sl[i]))
             for i in range(len(X_active))
         ]
 
-    def _score(mask, min_z, cross_pen, self_pen, x_active) -> float:
-        loss = shadow_loss(mask, target, _alpha, _beta, _gamma, _delta)
+    def _score(mask, min_z, cross_pen, self_pen, x_active, shadow=None) -> float:
+        loss = (
+            shadow_loss(mask, target, _alpha, _beta, _gamma, _delta)
+            if shadow is None
+            else shadow
+        )
 
         loss += floor_penalty_loss(
             min_z, _floor_z, _floor_penalty, _floor_margin, _floor_barrier

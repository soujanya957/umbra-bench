.DS_Store
__pycache__/
*.pyc
.venv/
external/*
!external/README.md
# `results/*` rather than `results/`: an excluded DIRECTORY cannot be
# re-entered by a later negation, so the batch-review folder below would be
# unreachable. Everything directly under results/ is still ignored.
results/*

# The review folder ships: one table of every solve, the command that exports
# each, and the clip it produced -- so a reader can see what the batch cast
# without re-solving 100+ clips first. Only the CURRENT-rig gifs are tracked;
# clips_legacy/ (the 0.15 archive) and every mp4 (54 MB, and the gif already
# carries the motion) stay local.
!results/batch_review/
results/batch_review/clips_legacy/
results/batch_review/**/*.mp4

# Per-run optimizer shadows: intermediates, regenerable from the seeds in
# results.json. Only <stem>_best.png is dataset content (metadata.jsonl carries a
# single shadows.optimizer.path per target).
optimized/**/*_run[0-9][0-9].png

# link_teleop.py / build_metadata.py timestamped backups
metadata.jsonl.bak_*

# Derived from sequences/ by make_sequence_frame_targets.py; regenerable
targets_sequences/
demo/out/reassembled/
demo/projects/*/out/reassembled/
demo/out/solve_logs/
demo/packages/
demo/projects/*/scenes/
demo/projects/*/letters_sam2_small/
demo/projects/*/letters_clean/
demo/projects/*/review/
demo/projects/*/frames_manifest.csv
demo/out/studio_logs/
demo/out/studio_state.json
# seq_video.py output: regenerable from the solve in one command,
# and a gif per clip is not what a git history is for
# demo/out/seqvideo/
*.bak_*

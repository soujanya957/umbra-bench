+/* Same rule as the teleop save/rerun pair, one view over. Cards are built lazily
+   on first visit, so the reveal runs from both ends -- whichever of the ping and
+   the render lands second finds the other already done. */
+/* null until the probe answers, so a card built before it lands neither shows a
+   button that will not work nor a hint that is about to be wrong. */
+let STUDIO_LIB = null;
+function applyStudioState(){
+  if(STUDIO_LIB === null) return;
+  document.querySelectorAll(".libbtn").forEach(b => { b.hidden = !STUDIO_LIB; });
+  // Hiding the button silently is what made this feature undiscoverable: opened
+  // as a plain file the page looked identical to one where the export had
+  // simply not been built. The hint is the absence explaining itself.
+  document.querySelectorAll(".libhint").forEach(h => { h.hidden = STUDIO_LIB; });
+}
+/* Probed once at load rather than from inside a view. This used to live in
+   renderTeleop, which meant a sequences card could only discover the studio
+   after someone had visited the teleop view first -- so the button was hidden
+   on the page that owns it. One shared promise, so there is still one request. */
+const STUDIO_PING = fetch("/api/ping")
+  .then(r => r.ok ? r.json() : null)
+  .catch(() => null);
+STUDIO_PING.then(j => { STUDIO_LIB = !!(j && j.library); applyStudioState(); });
+async function seqLibClick(e){
+  const b = e.target.closest(".libbtn"); if(!b) return;
+  const msg = b.parentElement.querySelector(".libmsg");
+  const label = b.textContent;
+  b.disabled = true; b.textContent = "exporting\u2026"; msg.textContent = "";
+  try{
+    const r = await fetch("/api/library/" + encodeURIComponent(b.dataset.sid),
+                          { method: "POST", headers: { "Content-Type": "application/json" },
+                            body: "{}" });
+    const j = await r.json();
+    if(!r.ok || j.error) throw new Error(j.error || r.status);
+    msg.textContent = "on the shelf \u2713";
+  }catch(err){
+    msg.textContent = String(err && err.message ? err.message : err);
+  }finally{ b.disabled = false; b.textContent = label; }
+}
